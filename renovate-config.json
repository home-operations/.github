{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigestsToSemver",
    "abandonments:recommended",
    ":automergePr",
    ":configMigration",
    ":dependencyDashboard",
    ":disableRateLimiting"
  ],
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/.mise/locks/**"
  ],
  "registryAliases": {
    "mirror.gcr.io": "docker.io"
  },
  "gitIgnoredAuthors": ["203671426+sticky-gecko[bot]@users.noreply.github.com"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Process annotated dependencies",
      "managerFilePatterns": ["/.*/"],
      "matchStrings": [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{/if}}"
    },
    {
      "description": [
        "Update home-operations/.github shared action pins (per-action prefixed tags)",
        "The github-actions manager cannot update these pins: both actions resolve to the same depName (home-operations/.github), and the pin comment (`workflow-lint-v1.0.2`) is not version-like, so extraction falls back to the github-digest datasource with exact versioning and no update is ever found.",
        "This manager keys the lookup on the action path instead and filters the repo's per-action prefixed tags via extractVersion. Sub-actions (`actions/<action>/<sub>`) are released under their parent's tags, so they key on the parent action too."
      ],
      "customType": "regex",
      "managerFilePatterns": ["/\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "uses: home-operations/\\.github/actions/(?<action>[\\w-]+)(?:/[\\w-]+)*@(?<currentDigest>[a-f0-9]{40})\\s+#\\s+[\\w-]+-(?<currentValue>v?\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "home-operations/.github/actions/{{{action}}}",
      "packageNameTemplate": "home-operations/.github",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^{{{action}}}-(?<version>v?\\d+\\.\\d+\\.\\d+)$",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "description": "Always chore, so that a dependency bump never makes release-please cut a release.",
      "matchPackageNames": ["*"],
      "semanticCommitType": "chore"
    },
    {
      "matchUpdateTypes": ["major", "minor", "patch"],
      "commitMessageExtra": "({{currentVersion}} → {{newVersion}})"
    },
    {
      "matchUpdateTypes": ["digest"],
      "commitMessageExtra": "({{currentDigestShort}} → {{newDigestShort}})"
    },
    {
      "matchDatasources": ["docker"],
      "semanticCommitScope": "container",
      "commitMessageTopic": "image {{depName}}"
    },
    {
      "matchDatasources": ["helm"],
      "semanticCommitScope": "helm",
      "commitMessageTopic": "chart {{depName}}"
    },
    {
      "matchManagers": ["gomod"],
      "semanticCommitScope": "go",
      "commitMessageTopic": "module {{depName}}"
    },
    {
      "matchManagers": ["cargo"],
      "semanticCommitScope": "rust",
      "commitMessageTopic": "crate {{depName}}"
    },
    {
      "matchManagers": ["npm"],
      "semanticCommitScope": "npm",
      "commitMessageTopic": "dependency {{depName}}"
    },
    {
      "matchManagers": ["github-actions"],
      "semanticCommitScope": "github-action",
      "commitMessageTopic": "action {{depName}}"
    },
    {
      "matchDatasources": ["github-releases"],
      "semanticCommitScope": "github-release",
      "commitMessageTopic": "release {{depName}}"
    },
    {
      "matchManagers": ["mise"],
      "semanticCommitScope": "mise",
      "commitMessageTopic": "tool {{depName}}"
    },
    {
      "matchDatasources": ["terraform-provider"],
      "semanticCommitScope": "terraform",
      "commitMessageTopic": "provider {{depName}}"
    },
    {
      "matchDatasources": ["terraform-module"],
      "semanticCommitScope": "terraform",
      "commitMessageTopic": "module {{depName}}"
    },
    {
      "matchDatasources": ["galaxy-collection"],
      "semanticCommitScope": "ansible",
      "commitMessageTopic": "collection {{depName}}"
    },
    {
      "matchDatasources": ["galaxy"],
      "semanticCommitScope": "ansible",
      "commitMessageTopic": "role {{depName}}"
    },
    {
      "matchUpdateTypes": ["major"],
      "labels": ["type/major"]
    },
    {
      "matchUpdateTypes": ["minor"],
      "labels": ["type/minor"]
    },
    {
      "description": [
        "zer0ver: a 0.x minor can break at any time. Label it as a major and put it on the major branch.",
        "The prefix lands it on the major-<groupSlug> branch that Renovate uses to split grouped majors, not on the non-major group PR.",
        "Keep this rule below the plain minor rule, so that it wins for 0.x."
      ],
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "/^v?0\\./",
      "labels": ["type/major"],
      "additionalBranchPrefix": "major-"
    },
    {
      "matchUpdateTypes": ["patch"],
      "labels": ["type/patch"]
    },
    {
      "matchUpdateTypes": ["digest"],
      "labels": ["type/digest"]
    },
    {
      "description": "GitHub Actions group",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Give these PRs the group and the commit format of the github-actions manager, so that they look like every other action bump.",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["home-operations/.github"],
      "groupName": "github-actions",
      "semanticCommitScope": "github-action",
      "commitMessageTopic": "action {{depName}}",
      "commitMessagePrefix": "{{semanticCommitType}}({{semanticCommitScope}}):"
    },
    {
      "description": [
        "Mise tools group: the catch-all for mise-managed dev tooling (linters, formatters, CLIs).",
        "Keep it above the toolchain rules, so that their groupName wins for go, rust and node. A later rule overrides an earlier one.",
        "Same minimumReleaseAge as the GitHub Actions group. A fresh release often uploads its per-arch assets and attestations after the tag appears. A lock taken too early leaves mise.lock without platform URLs."
      ],
      "matchManagers": ["mise"],
      "groupName": "mise tools",
      "groupSlug": "mise-tools",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Go toolchain group",
      "matchManagers": ["mise"],
      "matchDepNames": ["go"],
      "matchFileNames": [".mise/config.toml"],
      "groupName": "Go toolchain",
      "groupSlug": "go-toolchain"
    },
    {
      "description": "Rust toolchain group",
      "matchManagers": ["mise"],
      "matchDepNames": ["rust"],
      "matchFileNames": [".mise/config.toml"],
      "groupName": "Rust toolchain",
      "groupSlug": "rust-toolchain"
    },
    {
      "description": "Node toolchain group",
      "matchManagers": ["mise"],
      "matchDepNames": ["node"],
      "matchFileNames": [".mise/config.toml"],
      "groupName": "Node toolchain",
      "groupSlug": "node-toolchain"
    },
    {
      "description": [
        "npm: bump ranges and wait a day.",
        "pnpm 12 refuses a frozen install of a lockfile entry that is less than 24 hours old (ERR_PNPM_MINIMUM_RELEASE_AGE_VIOLATION). A PR opened sooner fails every install job for that day."
      ],
      "matchManagers": ["npm"],
      "rangeStrategy": "bump",
      "minimumReleaseAge": "1 day"
    },
    {
      "description": "Auto-merge non-major updates once the required checks pass.",
      "matchUpdateTypes": ["minor", "patch", "digest", "lockFileMaintenance"],
      "automerge": true
    },
    {
      "description": "zer0ver: a 0.x minor can break at any time, so do not auto-merge it. Devtools are the exception: a bad formatter or linter bump only breaks CI, and that is what the gate is for.",
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "/^v?0\\./",
      "matchDepNames": [
        "!aqua:dadav/helm-schema",
        "!helm-unittest/helm-unittest",
        "!oxfmt",
        "!shellcheck"
      ],
      "automerge": false
    },
    {
      "description": [
        "Auto-merge trusted GitHub Actions.",
        "No minimumReleaseAge here. The GitHub Actions group rule above matches the same actions and supplies the three-day release age."
      ],
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["/^actions\\//", "/^docker\\//"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false
    }
  ]
}
