{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigestsToSemver",
    "abandonments:recommended",
    "./renovate/annotated.json5",
    "./renovate/autoMerge.json5",
    "./renovate/groups.json5",
    "./renovate/labels.json5",
    "./renovate/semanticCommits.json5",
    "./renovate/sharedActions.json5",
    ":automergePr",
    ":configMigration",
    ":dependencyDashboard",
    ":disableRateLimiting"
  ],
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/.mise/locks/**"
  ],
  "registryAliases": {
    "mirror.gcr.io": "docker.io"
  },
  "gitIgnoredAuthors": ["203671426+sticky-gecko[bot]@users.noreply.github.com"],
  "packageRules": [
    {
      "description": "NPM Bump Range Strategy",
      "matchManagers": ["npm"],
      "rangeStrategy": "bump"
    }
  ]
}
